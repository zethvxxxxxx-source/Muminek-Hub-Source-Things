local MuminekHub = loadstring(game:HttpGet("https://pastebin.com/raw/wY0zjBQg"))()

-- == Hotkeys == --
do
    -- Konfiguracja
    local CONFIG = {
        BackgroundColor = Color3.fromRGB(20, 22, 27),
        BackgroundTransparency = 0.075,
        CornerRadius = 10,
        BorderColor = Color3.fromRGB(45, 48, 58),
        BorderTransparency = 0.65,
        BorderThickness = 1.5,
        PaddingX = 12,
        PaddingY = 8,
        RowSpacing = 4,
        RowHeight = 22,
        IconSize = 16,
        TextSize = 13,
        KeySize = 12,
        IconColor = Color3.fromRGB(78, 127, 252),
        TextColor = Color3.fromRGB(255, 255, 255),
        KeyColor = Color3.fromRGB(180, 180, 180),
        Width = 200,
        Position = UDim2.new(0, 25, 0, 250),
        UseBlur = true,
        UseShadow = true,
    }

    -- Glowna Ramka
    local HotkeysFrame = Instance.new("Frame")
    HotkeysFrame.Name = MuminekHub.RandomString()
    HotkeysFrame.Parent = MuminekHub.ScreenGui
    HotkeysFrame.BackgroundColor3 = CONFIG.BackgroundColor
    HotkeysFrame.BackgroundTransparency = CONFIG.BackgroundTransparency
    HotkeysFrame.BorderSizePixel = 0
    HotkeysFrame.Position = CONFIG.Position
    HotkeysFrame.Size = UDim2.new(0, CONFIG.Width, 0, 30)
    HotkeysFrame.ZIndex = 100
    HotkeysFrame.ClipsDescendants = true
    HotkeysFrame.Visible = true

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, CONFIG.CornerRadius)
    UICorner.Parent = HotkeysFrame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = CONFIG.BorderColor
    UIStroke.Transparency = CONFIG.BorderTransparency
    UIStroke.Thickness = CONFIG.BorderThickness
    UIStroke.Parent = HotkeysFrame

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = HotkeysFrame
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, CONFIG.RowSpacing)
    UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local UIPadding = Instance.new("UIPadding")
    UIPadding.Parent = HotkeysFrame
    UIPadding.PaddingTop = UDim.new(0, CONFIG.PaddingY)
    UIPadding.PaddingBottom = UDim.new(0, CONFIG.PaddingY)
    UIPadding.PaddingLeft = UDim.new(0, CONFIG.PaddingX)
    UIPadding.PaddingRight = UDim.new(0, CONFIG.PaddingX)

    -- === SHADOW ===
    local Shadow
    if CONFIG.UseShadow then
        pcall(function()
            Shadow = MuminekHub:CreateShadow(HotkeysFrame)
            Shadow:Render(true)
        end)
    end

    -- === BLUR ===
    local blurSignal
    if CONFIG.UseBlur then
        pcall(function()
            blurSignal = MuminekHub:CreateSignal(true)
            MuminekHub:CreateBlurModule(HotkeysFrame, blurSignal)
        end)
    end

    -- === RĘCZNE PRZELICZANIE ROZMIARU (bez AutomaticSize) ===
    local function updateFrameSize()
        local rows = 0
        for _, child in pairs(HotkeysFrame:GetChildren()) do
            if child:IsA("Frame") and child:FindFirstChildWhichIsA("TextLabel") then
                rows = rows + 1
            end
        end
        local totalHeight = (rows * CONFIG.RowHeight) + (math.max(0, rows - 1) * CONFIG.RowSpacing) + (CONFIG.PaddingY * 2)
        if totalHeight < 20 then totalHeight = 20 end
        HotkeysFrame.Size = UDim2.new(0, CONFIG.Width, 0, totalHeight)
    end

    -- === FUNKCJA TWORZĄCA WIERSZ ===
    local function createHotkeyRow(name, icon, key, layoutOrder, bold)
        local Row = Instance.new("Frame")
        Row.Name = MuminekHub.RandomString()
        Row.Parent = HotkeysFrame
        Row.BackgroundTransparency = 1
        Row.Size = UDim2.new(1, 0, 0, CONFIG.RowHeight)
        Row.LayoutOrder = layoutOrder
        Row.ZIndex = 101

        local IconLabel = Instance.new("TextLabel")
        IconLabel.Name = MuminekHub.RandomString()
        IconLabel.Parent = Row
        IconLabel.BackgroundTransparency = 1
        IconLabel.Size = UDim2.new(0, CONFIG.IconSize + 6, 1, 0)
        IconLabel.Position = UDim2.new(0, 0, 0, 0)
        IconLabel.FontFace = MuminekHub.BuiltInBold
        IconLabel.Text = icon or "circle"
        IconLabel.TextColor3 = CONFIG.IconColor
        IconLabel.TextSize = CONFIG.IconSize
        IconLabel.TextXAlignment = Enum.TextXAlignment.Left
        IconLabel.ZIndex = 102

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Name = MuminekHub.RandomString()
        NameLabel.Parent = Row
        NameLabel.BackgroundTransparency = 1
        NameLabel.Size = UDim2.new(1, -(CONFIG.IconSize + 10) - 70, 1, 0)
        NameLabel.Position = UDim2.new(0, CONFIG.IconSize + 6, 0, 0)
        NameLabel.Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium
        NameLabel.Text = name or "Hotkey"
        NameLabel.TextColor3 = CONFIG.TextColor
        NameLabel.TextSize = CONFIG.TextSize
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.ZIndex = 102

        local KeyLabel = Instance.new("TextLabel")
        KeyLabel.Name = MuminekHub.RandomString()
        KeyLabel.Parent = Row
        KeyLabel.BackgroundTransparency = 1
        KeyLabel.Size = UDim2.new(0, 70, 1, 0)
        KeyLabel.Position = UDim2.new(1, -70, 0, 0)
        KeyLabel.Font = Enum.Font.GothamBold
        KeyLabel.Text = "[" .. tostring(key) .. "]"
        KeyLabel.TextColor3 = CONFIG.KeyColor
        KeyLabel.TextSize = CONFIG.KeySize
        KeyLabel.TextXAlignment = Enum.TextXAlignment.Right
        KeyLabel.ZIndex = 102

        return Row, IconLabel, NameLabel, KeyLabel
    end

    -- === API ===
    local HUD = {}
    local activeHotkeys = {}
    local currentLayoutOrder = 0

    function HUD:AddHotkey(config)
        config = config or {}
        if not config.Name then return nil end
        if activeHotkeys[config.Name] then
            HUD:RemoveHotkey(config.Name)
        end
        currentLayoutOrder = currentLayoutOrder + 1
        local row, iconL, nameL, keyL = createHotkeyRow(
            config.Name,
            config.Icon or "circle",
            config.Key or "None",
            currentLayoutOrder,
            config.Bold == true
        )
        activeHotkeys[config.Name] = {
            row = row,
            icon = iconL,
            name = nameL,
            key = keyL,
            bold = config.Bold == true
        }
        updateFrameSize()
        return activeHotkeys[config.Name]
    end

    function HUD:RemoveHotkey(name)
        if activeHotkeys[name] then
            activeHotkeys[name].row:Destroy()
            activeHotkeys[name] = nil
            updateFrameSize()
        end
    end

    function HUD:UpdateKey(name, newKey)
        if activeHotkeys[name] then
            local newText = "[" .. tostring(newKey) .. "]"
            if activeHotkeys[name].key.Text ~= newText then
                activeHotkeys[name].key.Text = newText
            end
        end
    end

    function HUD:UpdateName(name, newName)
        if activeHotkeys[name] then
            if activeHotkeys[name].name.Text ~= newName then
                activeHotkeys[name].name.Text = newName
            end
        end
    end

    function HUD:UpdateIcon(name, newIcon)
        if activeHotkeys[name] then
            if activeHotkeys[name].icon.Text ~= newIcon then
                activeHotkeys[name].icon.Text = newIcon
            end
        end
    end

    function HUD:ClearAll()
        for name, _ in pairs(activeHotkeys) do
            HUD:RemoveHotkey(name)
        end
        updateFrameSize()
    end

    -- === KUSTOMIZACJA ===
    function HUD:SetBackgroundColor(color)
        CONFIG.BackgroundColor = color
        HotkeysFrame.BackgroundColor3 = color
    end

    function HUD:SetBackgroundTransparency(transparency)
        CONFIG.BackgroundTransparency = transparency
        HotkeysFrame.BackgroundTransparency = transparency
    end

    function HUD:SetBorderColor(color)
        CONFIG.BorderColor = color
        UIStroke.Color = color
    end

    function HUD:SetBorderTransparency(transparency)
        CONFIG.BorderTransparency = transparency
        UIStroke.Transparency = transparency
    end

    function HUD:SetIconColor(color)
        CONFIG.IconColor = color
        for _, data in pairs(activeHotkeys) do
            data.icon.TextColor3 = color
        end
    end

    function HUD:SetTextColor(color)
        CONFIG.TextColor = color
        for _, data in pairs(activeHotkeys) do
            data.name.TextColor3 = color
        end
    end

    function HUD:SetKeyColor(color)
        CONFIG.KeyColor = color
        for _, data in pairs(activeHotkeys) do
            data.key.TextColor3 = color
        end
    end

    function HUD:SetPosition(position)
        CONFIG.Position = position
        HotkeysFrame.Position = position
    end

    function HUD:SetVisible(visible)
        HotkeysFrame.Visible = visible
        if blurSignal then
            pcall(function() blurSignal:SetValue(visible) end)
        end
        if Shadow then
            pcall(function() Shadow:Render(visible) end)
        end
    end

    function HUD:SetWidth(width)
        CONFIG.Width = width
        updateFrameSize()
    end

    function HUD:Destroy()
        if Shadow then pcall(function() Shadow:Render(false) end) end
        if blurSignal then pcall(function() blurSignal:SetValue(false) end) end
        HotkeysFrame:Destroy()
        activeHotkeys = {}
    end

    -- === ZAPISZ W GLOBALU ===
    _G.MuminekHotkeys = HUD

    if DEBUG_MODE then
        print("Hotkeys HUD załadowany")
    end
end

    -- == Hotkeys == --
    _G.MuminekHotkeys:AddHotkey({ Name = "Hotkeys", Icon = "key-command", Key = "B", Bold = true })
