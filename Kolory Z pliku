-- =============================================================
--  PREFERENCJE KOLORU – Muminek Hub
--  Wklej PO załadowaniu biblioteki (MuminekHub, Notification, Logging)
-- =============================================================
do
    local PREFERENCES_FOLDER = "Muminek_Preferences"

    -- === MAPA KOLORÓW ===
    local COLOR_MAP = {
        ["Niebieski"]    = Color3.fromRGB(78, 127, 252),
        ["Czerwony"]     = Color3.fromRGB(255, 0, 0),
        ["Pomarańczowy"] = Color3.fromRGB(255, 132, 0),
        ["Żółty"]        = Color3.fromRGB(255, 255, 0),
        ["Zielony"]      = Color3.fromRGB(0, 217, 0),
        ["Miętowy"]      = Color3.fromRGB(0, 255, 150),
        ["Turkusowy"]    = Color3.fromRGB(0, 255, 255),
        ["Fioletowy"]    = Color3.fromRGB(105, 0, 209),
        ["Różowy"]       = Color3.fromRGB(255, 20, 147),
        ["Koralowy"]     = Color3.fromRGB(255, 127, 80),
        ["Biały"]        = Color3.fromRGB(255, 255, 255),
        ["Szary"]        = Color3.fromRGB(180, 180, 180),
    }

    -- === 1. TWORZENIE FOLDERU ===
    if not isfolder(PREFERENCES_FOLDER) then
        local success, err = pcall(makefolder, PREFERENCES_FOLDER)
        if success then
            print("[Preferences] Folder utworzony: " .. PREFERENCES_FOLDER)
        else
            warn("[Preferences] Nie udało się utworzyć folderu: " .. tostring(err))
        end
    end

    -- === 2. SPRAWDZANIE PLIKÓW TXT ===
    local appliedColor = nil
    local appliedColorName = nil

    local ok, files = pcall(listfiles, PREFERENCES_FOLDER)
    if ok and files then
        for _, filePath in pairs(files) do
            local fileName = filePath:match("([^/\\]+)$")
            if fileName then
                local colorName = fileName:match("^(.+)%.txt$")
                if colorName and COLOR_MAP[colorName] then
                    appliedColor = COLOR_MAP[colorName]
                    appliedColorName = colorName
                    break
                end
            end
        end
    end

    -- === 3. ZASTOSOWANIE KOLORU ===
    if appliedColor then
        MuminekHub.AccentColor = appliedColor

        if Notification and Notification.new then
            Notification.new({
                Title = "Preferences",
                Content = "Wczytano kolor: " .. appliedColorName,
                Duration = 4,
            })
        end

        if Logging and Logging.new then
            Logging.new("paint-brush", "Kolor ustawiony z preferencji: " .. appliedColorName, 5)
        end
    else
        -- Brak pliku z kolorem – użyj domyślnego
        MuminekHub.AccentColor = COLOR_MAP["Niebieski"]

        if Logging and Logging.new then
            Logging.new("paint-brush", "Brak preferencji – użyto domyślnego (Niebieski)", 3)
        end
    end

    -- === 4. FUNKCJA POMOCNICZA – zapis preferencji ===
    function _G.SaveColorPreference(colorName)
        if not COLOR_MAP[colorName] then
            warn("[Preferences] Nieznany kolor: " .. tostring(colorName))
            return false
        end

        -- Usuń stare pliki TXT w folderze
        local ok2, existing = pcall(listfiles, PREFERENCES_FOLDER)
        if ok2 and existing then
            for _, filePath in pairs(existing) do
                local name = filePath:match("([^/\\]+)$")
                if name and name:match("%.txt$") then
                    pcall(delfile, filePath)
                end
            end
        end

        -- Zapisz nowy plik
        local success = pcall(function()
            writefile(PREFERENCES_FOLDER .. "/" .. colorName .. ".txt", colorName)
        end)

        if success then
            print("[Preferences] Zapisano preferencję: " .. colorName)
            return true
        end
        return false
    end
end
